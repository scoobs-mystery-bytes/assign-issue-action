{
  "name": "issue-assignment-approvals",
  "main": "worker.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "APPROVALS", "class_name": "AssignmentApprovals" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AssignmentApprovals"] }
  ],
  "vars": {
    "GITHUB_REPOSITORY": "parcelis/parcelis",
    "DISCORD_APPLICATION_ID": "",
    "DISCORD_GUILD_ID": "",
    "DISCORD_CHANNEL_ID": "",
    "DISCORD_APPROVER_USER_IDS": "",
    "DISCORD_APPROVER_ROLE_IDS": "",
    "GITHUB_REQUIRED_LABEL": ""
  }
}
